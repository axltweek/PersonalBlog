---
import { getConfigurationCollection } from "../lib/utils";
import Anchor from "./common/Anchor.astro";
import Section from "./common/Section.astro";

const { data: config } = await getConfigurationCollection();

const date = new Date();
const year = date.getFullYear();
---

<footer class="mt-16 mb-8">
  <Section class="mb-4">
    <div
      class="zag-border-b zag-border-animated zag-transition pb-4 flex flex-col sm:flex-row sm:flex-nowrap gap-8 sm:items-center"
    >
      <ul class="flex flex-col gap-2">
        {
          Object.entries(config.menu).map((i) => (
            <li>
              <Anchor url={i[1]}>{i[0]}</Anchor>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-start items-start gap-4 w-full">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          class="zag-fill zag-transition w-8 h-8 min-h-8 min-w-8 max-h-8 max-w-8 -translate-y-2"
        >
          <title>Quote</title>
          <path
            fill="currentColor"
            d="m10 7l-2 4h3v6H5v-6l2-4zm8 0l-2 4h3v6h-6v-6l2-4z"></path>
        </svg>
        <!-- Remove the quote paragraph if you don't want quotes in the footer -->
        <div class="flex flex-col gap-1">
          <p id="quote" class="zag-text zag-transition"></p>
          <p id="quoteSource" class="zag-muted zag-transition text-xs text-right"></p>
        </div>
      </div>
      <div class="flex flex-row sm:flex-col gap-4">
        {
          config.personal.githubProfile && (
            <Anchor url={config.personal.githubProfile} aria-label={`${config.personal.name} GitHub Profile`}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
              >
                <title>Github</title>
                <path
                  class="zag-fill zag-transition"
                  d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
                />
              </svg>
            </Anchor>
          )
        }
        {
          config.personal.devtoProfile && (
            <Anchor url={config.personal.devtoProfile} aria-label={`${config.personal.name} dev.to Profile`}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 32 32"
              >
                <title>dev.to</title>
                <rect x="0" y="0" width="32" height="32" rx="5" class="zag-fill zag-transition"/>
                <text
                  x="16"
                  y="21"
                  text-anchor="middle"
                  font-family="monospace"
                  font-size="15"
                  font-weight="bold"
                  class="-zag-fill zag-transition"
                >DEV</text>
              </svg>
            </Anchor>
          )
        }
        {
          config.personal.linkedinProfile && (
            <Anchor url={config.personal.linkedinProfile} aria-label={`${config.personal.name} LinkedIn Profile`}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
              >
                <title>LinkedIn</title>
                <path
                  class="zag-fill zag-transition"
                  fill="currentColor"
                  d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11.12 19h-3.08v-9h3.08v9zm-1.54-10.29c-.99 0-1.79-.8-1.79-1.79s.8-1.79 1.79-1.79 1.79.8 1.79 1.79-.8 1.79-1.79 1.79zm13.16 10.29h-3.08v-4.89c0-1.16-.02-2.64-1.61-2.64s-1.86 1.26-1.86 2.57v4.96h-3.08v-9h2.96v1.23h.04c.41-.78 1.4-1.6 2.88-1.6 3.08 0 3.65 2.03 3.65 4.66v4.71z"
                />
              </svg>
            </Anchor>
          )
        }
      </div>
    </div>
  </Section>
  <p class="zag-text zag-transition text-center text-sm font-medium">
    &copy; {year}
    {config.personal.name}. All rights reserved.
  </p>
</footer>

<script>
  const quotes = [
    {
      quote: "DEVELOPERS! DEVELOPERS! DEVELOPERS! DEVELOPERS!",
      source: "Steve Ballmer, Microsoft CEO, 2000",
    },
    {
      quote: "640K ought to be enough for anybody.",
      source: "Bill Gates, 1981 (probably apocryphal, but too good to drop)",
    },
    {
      quote: "It works on my machine.",
      source: "Every developer, always",
    },
    {
      quote: "There are only 10 types of people: those who understand binary and those who don't.",
      source: "Ancient nerd proverb",
    },
    {
      quote: "Why do programmers prefer dark mode? Because light attracts bugs.",
      source: "Stack Overflow, comment section",
    },
    {
      quote: "It's not a bug, it's an undocumented feature.",
      source: "Anonymous, circa forever",
    },
    {
      quote: "Real programmers count from 0.",
      source: "Dijkstra's ghost",
    },
    {
      quote: "sudo make me a sandwich.",
      source: "xkcd #149",
    },
    {
      quote: "Have you tried turning it off and on again?",
      source: "Moss, The IT Crowd",
    },
    {
      quote: "Move fast and break things.",
      source: "Mark Zuckerberg (before things got expensive)",
    },
    {
      quote: "A computer never does what you want, only what you tell it.",
      source: "Murphy's Law of Computing",
    },
    {
      quote: "The best code is no code at all.",
      source: "Jeff Atwood, Coding Horror",
    },
    {
      quote: "There are two hard things in computer science: cache invalidation, naming things, and off-by-one errors.",
      source: "Phil Karlton (extended edition)",
    },
    {
      quote: "rm -rf / — just to be sure.",
      source: "No one who survived",
    },
    {
      quote: "It compiles. Ship it.",
      source: "Startup engineering handbook",
    },
    {
      quote: "Any sufficiently advanced bug is indistinguishable from a feature.",
      source: "Rich Kulawiec",
    },
    {
      quote: "First, solve the problem. Then, write the code.",
      source: "John Johnson",
    },
    {
      quote: "CSS: a language where you ask the browser for a red circle and receive a blue square in a different timezone.",
      source: "Twitter, collectively",
    },
    {
      quote: "git commit -m 'fix' && git push --force",
      source: "A developer at 3am",
    },
    {
      quote: "Works fine in production. Don't touch it.",
      source: "Senior engineer's README",
    },
    {
      quote: "Turn on, tune in, drop out.",
      source: "Timothy Leary",
    },
  ];
  const quoteElement = document.getElementById("quote");
  const quoteSourceElement = document.getElementById("quoteSource");
  const randomIndex = Math.floor(Math.random() * quotes.length);
  const randomQuote = quotes[randomIndex];
  if (quoteElement) {
    quoteElement.textContent = randomQuote.quote;
    quoteElement.classList.add("zag-quote-pulse");
  }
  if (quoteSourceElement) {
    quoteSourceElement.textContent = `— ${randomQuote.source}`;
    quoteSourceElement.classList.add("zag-quote-pulse");
  }
</script>
