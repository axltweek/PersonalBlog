---
import { getCollection } from "astro:content";
import Section from "../../components/common/Section.astro";
import ProjectSnippet from "../../components/ProjectSnippet.astro";
import Layout from "../../layouts/Layout.astro";
import { getConfigurationCollection } from "../../lib/utils";
import MetaTags from "../../components/common/MetaTags.astro";

const projects = (await getCollection("project")).sort(
	(a, b) => b.data.timestamp.valueOf() - a.data.timestamp.valueOf(),
);

const { data: config } = await getConfigurationCollection();
---

<Layout>
  <Fragment slot="head">
    <MetaTags
      title={config.projectMeta.title}
      description={config.projectMeta.description}
      longDescription={config.projectMeta.longDescription}
      cardImage={config.projectMeta.cardImage}
      keywords={config.projectMeta.keywords}
      url={`${config.site.baseUrl}/projects`}
      languageCode={config.site.languageCode}
      languageName={config.site.languageName}
    />
  </Fragment>
  <Section class="py-4 my-8">
    <div class="flex items-center gap-4 pt-8 pb-16">
      <h1 class="font-display text-3xl sm:text-4xl leading-loose">{config.texts.projectsName}</h1>
    </div>
    <ul>
      {
        projects.map((project) => (
          <li>
            <ProjectSnippet
              title={project.data.title}
              description={project.data.description}
              url={`/projects/${project.data.slug}`}
              githubUrl={project.data.githubUrl}
              liveUrl={project.data.liveDemoUrl}
              tags={project.data.tags ?? []}
            />
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
