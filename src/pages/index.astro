---
import { getCollection } from "astro:content";
import Section from "../components/common/Section.astro";
import FeaturedArticles from "../components/home/FeaturedArticles.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import Hero from "../components/home/Hero.astro";
import Layout from "../layouts/Layout.astro";
import { getConfigurationCollection } from "../lib/utils";
import MetaTags from "../components/common/MetaTags.astro";

const { data: config } = await getConfigurationCollection();

const featuredProjects = (
	await getCollection("project", (e) => e.data.featured)
).map((e) => ({
	...e.data,
  url: `/projects/${e.data.slug}`,
}));
const featuredArticles = (
	await getCollection("blog", (e) => e.data.featured)
).map((e) => ({
	...e.data,
  url: `/blog/${e.data.slug}`,
}));
---

<Layout>
  <Fragment slot="head">
    <MetaTags
      title={config.globalMeta.title}
      description={config.globalMeta.description}
      longDescription={config.globalMeta.longDescription}
      cardImage={config.globalMeta.cardImage}
      keywords={config.globalMeta.keywords}
      url={config.site.baseUrl}
      languageCode={config.site.languageCode}
      languageName={config.site.languageName}
    />
  </Fragment>
  <Section class="my-16">
    <Hero />
  </Section>
  <Section>
    <FeaturedProjects featuredProjects={featuredProjects} />
  </Section>
  <Section>
    <FeaturedArticles featuredArticles={featuredArticles} />
  </Section>
</Layout>
